# ==============================================================================
# Environment Configuration — Artisan AI Business Copilot (Speech & Translation)
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Render Platform Configuration
# Render automatically sets PORT and RENDER_EXTERNAL_URL in production
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# Supabase PostgreSQL Configuration
# (Service will operate with safe mock/in-memory adapter if credentials are unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Cloud APIs Configuration
# Set your Google Cloud API key for Speech-to-Text and Cloud Translation.
# (If left empty, the application runs with mock audio transcribing and local translation)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here

# Hugging Face Fine-Tuned Qwen Model (Free Serverless Inference API)
HF_MODEL_REPO=harshvdn2/qwen-artisan-description
HF_TOKEN=your-huggingface-write-token-here
